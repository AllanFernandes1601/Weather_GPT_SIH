# Gemini is called only from the backend. Put the real key in .env, never here.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.6-flash"

# Optional hosted application URL.
APP_URL="YOUR_APP_URL"

# Optional API origin for Capacitor Android builds. Leave empty for the web app;
# set this to the reachable backend origin, such as http://<your-machine-ip>:3000.
VITE_API_URL=""

# Python executables and local structured-retrieval database.
RAG_PYTHON_BIN="python3"
ML_PYTHON_BIN=".venv/bin/python"
WEATHERGPT_RAG_DB="rag/data/weathergpt.sqlite"

# Used only when running npm run rag:ingest.
WEATHERGPT_CLEAN_DATA_DIR="/absolute/path/to/cleaned/weathergpt/csvs"
